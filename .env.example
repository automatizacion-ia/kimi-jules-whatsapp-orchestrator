# =============================================================================
# Configuración del orquestador: Kimi + Jules + WhatsApp (whatsapp-web.js) + Herdr
# =============================================================================

# -----------------------------------------------------------------------------
# WhatsApp Web (whatsapp-web.js)
# -----------------------------------------------------------------------------
WHATSAPP_SESSION_NAME=mfco-session
CHROME_BIN=/usr/bin/chromium-browser

# Número de WhatsApp del administrador para notificaciones de GitHub.
# Formato internacional sin +, por ejemplo: 5491123456789@c.us
# Si usás un LID, el sistema lo resuelve automáticamente.
ADMIN_WHATSAPP_NUMBER=

# -----------------------------------------------------------------------------
# Webhook receiver
# -----------------------------------------------------------------------------
WEBHOOK_PORT=3001
# Secreto para validar webhooks entrantes de WhatsApp (cualquier string largo)
WEBHOOK_SECRET=tu-webhook-secret-aqui
# Secreto para validar webhooks entrantes de GitHub (configurar en el webhook del repo)
GITHUB_WEBHOOK_SECRET=tu-github-webhook-secret-aqui

# -----------------------------------------------------------------------------
# Herdr
# -----------------------------------------------------------------------------
# El socket se resuelve automáticamente desde HOME=/var/lib/herdr
HERDR_HOME=/var/lib/herdr
HERDR_WORKSPACE=w1
HERDR_PANE_KIMI=w1:p1

# -----------------------------------------------------------------------------
# GitHub (para que Kimi cree issues/PRs y Jules los ejecute)
# -----------------------------------------------------------------------------
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_ORG=automatizacion-ia
# Repo por defecto donde Jules trabaja. Se puede sobreescribir por mensaje.
# Dejar vacío si querés especificar el repo en cada mensaje.
GITHUB_DEFAULT_REPO=mi-repo

# -----------------------------------------------------------------------------
# Kimi (opcional, si se usa API directa además del CLI)
# -----------------------------------------------------------------------------
KIMI_API_KEY=opcional

# Tiempo de espera por respuesta de Kimi (ms)
KIMI_RESPONSE_TIMEOUT_MS=30000
